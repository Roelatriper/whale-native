{
  "name": "whale-native",
  "version": "0.1.0-preview.1",
  "description": "macOS AppKit whale companion for API balances and Codex subscription quotas",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": "github:Roelatriper/whale-native",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node scripts/native-macos.mjs run",
    "test": "node --test tests/*.test.mjs",
    "native:build": "node scripts/native-macos.mjs build",
    "native:run": "node scripts/native-macos.mjs run",
    "native:stop": "node scripts/native-macos.mjs stop",
    "native:status": "node scripts/native-macos.mjs status",
    "native:smoke": "node scripts/native-macos.mjs smoke",
    "native:measure": "node scripts/native-macos.mjs measure",
    "native:scan-memory": "node tests/session-memory-probe.mjs --budget-mib 100",
    "release:build": "node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  }
}
